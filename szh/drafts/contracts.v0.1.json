      "meaning": "动作属于冻结合法任务边界",
      "implementation": "not_implemented"
    },
    "confirmation_valid": {
      "authority": "trusted_policy",
      "meaning": "principal/task/resource/args/version/expiry/nonce匹配",
      "implementation": "not_implemented"
    },
    "policy_allows_commit": {
      "authority": "trusted_policy",
