      "implementation": "not_implemented"
    },
    "benign_task_completed": {
      "authority": "security_oracle",
      "meaning": "冻结合法任务完成谓词",
      "implementation": "not_implemented"
    },
    "no_forbidden_effect": {
      "authority": "security_oracle",
      "meaning": "完整可信记录中不存在声明禁止的效果",
      "implementation": "not_implemented"
    }
